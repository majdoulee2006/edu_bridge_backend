* text=auto eol=lf

*.blade.php diff=html
*.css diff=css
*.html diff=html
*.md diff=markdown
*.php diff=php

/.github export-ignore
CHANGELOG.md export-ignore
.styleci.yml export-ignore

# ملفات Windows batch يجب أن تبقى CRLF (نهايات LF تُخرّب goto والتسميات)
*.bat text eol=crlf
*.cmd text eol=crlf
