TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_FORWARD_NOTIFICATIONS=true
GEMINI_API_KEY=
GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.7-flash,gemini-3.5-flash
GEMINI_TIMEOUT=12

# --- الأمان ---
# أصول CORS المسموحة (مفصولة بفاصلة). الافتراضي: localhost فقط
CORS_ALLOWED_ORIGINS=
# صلاحية توكن التطبيق بالدقائق (43200 = 30 يوماً)
SANCTUM_EXPIRATION=43200
# رمز OTP ثابت للتطوير فقط. اتركه فارغاً في الإنتاج
OTP_FIXED_CODE=
# مضيفات موثوقة إضافية لروابط المساعد الذكي (مفصولة بفاصلة)
AI_ALLOWED_HOSTS=

# Weekly parent digest (docs/ar/12-innovation-plan.md)
DIGEST_ENABLED=true
DIGEST_USE_AI=true
DIGEST_SEND_DAY=thursday
DIGEST_SEND_TIME=18:00
